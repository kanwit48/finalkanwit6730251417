  `position` VARCHAR(255) GENERATED ALWAYS AS (`NinSom_Position_Employee`) VIRTUAL,
  `status` VARCHAR(50) GENERATED ALWAYS AS (`NinSom_Status_Employee`) VIRTUAL,
